{
	"name": "Enterprise AI - Python & pgvector",
	"image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"enableNonRootDocker": "true",
			"moby": "true"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-azuretools.vscode-docker",
				"mtakhtar.pgvector",
				"cweijan.vscode-postgresql-client2"
			]
		}
	},
	"postCreateCommand": "pip install -r enterprise-ai-knowledge-integration/requirements.txt && pip install pytest httpx pytest-asyncio pytest-cov",
	"remoteUser": "vscode"
}
